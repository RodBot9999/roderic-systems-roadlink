{
  "name": "roadlink-fleet-desktop",
  "productName": "RoadLink Fleet",
  "version": "0.2.0",
  "description": "Open-source desktop fleet telemetry dashboard for RoadLink devices",
  "author": "RoadLink",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "test": "node --test tests/telemetry-server.test.cjs tests/simulator-e2e.test.cjs",
    "preview": "vite preview",
    "dist:win": "pnpm run build && electron-builder --win nsis",
    "pack:win": "pnpm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "1.28.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "38.2.0",
    "electron-builder": "24.13.3",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wait-on": "9.0.3"
  },
  "build": {
    "appId": "dev.roadlink.fleet",
    "productName": "RoadLink Fleet",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "RoadLink-Fleet-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
